{
  "name": "ness-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3210",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/ness next build",
    "check:links": "bun scripts/check-links.ts && bun scripts/check-docs.ts",
    "start": "serve out -l 3210",
    "types:check": "next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "geist": "1.8.1",
    "lucide-react": "^1.61.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
