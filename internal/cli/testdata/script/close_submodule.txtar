# An initialized submodule keeps its commits in the worktree's module store, which close deletes:
# a plain close refuses (exit 4) and leaves the worktree; --discard is the way out.
# covers: R-SESS-064
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m 'ness init'
exec git init -q -b main ../sub
exec git -C ../sub commit -q --allow-empty -m sub
exec ness open --root --scope r --tier standard --brief ../b.md
store last-session R
exec sh -c 'cd .worktrees/r-* && git -c protocol.file.allow=always submodule add -q $WORK/sub sub && printf "## Lessons\nNone.\n" > docs/sessions/r/report.md && git add -A && git commit -q -m r && NESS_SESSION=$R ness integrate --subject "feat: x"'
exits 4 ness close $R
stderr 'initialized submodules \(sub\)'
exec git worktree list
stdout 'worktrees/r-'
exec git branch --list 'session/r-*'
stdout 'session/r-'
store session $R closed=false
exec ness close $R --discard
store session $R closed=true

-- b.md --
b
