# The behind fyi reads the base branch's lock, not the working tree's: an uncommitted older lock
# sends nothing; the same lock committed on the base sends one; an unreadable one is logged once.
# covers: R-UPD-082
env NESS_TEST_VERSION=0.2.0
env NESS_TEST_NOW=2026-10-08T10:00:00Z
cd repo
exec ness init --gate true --base main --yes
grep '"ness": "0.2.0"' .ness/lock.json
exec git add -A
exec git commit -q -m 'ness init'
store add-session s-r r
# rejects: a lock read from the working tree (an edit, a conflict, another branch's checkout)
exec sed -i 's/"ness": "0.2.0"/"ness": "0.1.0"/' .ness/lock.json
exec ness worker run --once
store items s-r 0
exec git commit -q -am 'old lock'
exec ness worker run --once
store items s-r 1

# An unreadable base lock (no such base branch) is logged once per cause across passes.
# rejects: a project silently neither upgraded nor said to be behind
exec sed -i 's/^base = .*/base = "nosuch"/' .ness/ness.toml
cp $WORK/empty .git/ness/worker.log
exec ness worker run --once
exec ness worker run --once
grep -count=1 'error update the base lock cannot be read: base nosuch' .git/ness/worker.log
-- empty --
