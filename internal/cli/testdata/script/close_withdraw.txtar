# close --withdraw settles every open item the closer sent the child as withdrawn, the note as the
# reason, a deferred one included, and closes in one step. Without the flag the closer's own open
# request still blocks the close, and the refusal names --withdraw.
# covers: R-SESS-130, R-SESS-131
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m 'ness init'
exec ness open --root --scope r --tier standard --brief ../b.md
store last-session R
exec sh -c 'cd .worktrees/r-* && NESS_SESSION=$R ness open --scope c --tier standard --brief ../../../b.md'
store last-session C
exec sh -c 'cd .worktrees/c-* && printf "## Lessons\nNone.\n" > docs/sessions/r/c/report.md && git add -A && git commit -q -m report && NESS_SESSION=$C ness integrate --subject "feat: x"'
env NESS_SESSION=$R
exec ness send --to $C --body req --intent request
store last $C REQ
exec ness send --to $C --body dec --intent decision
store last $C DEC
env NESS_SESSION=$C
exec ness reply $DEC --body later --as deferred
# Without --withdraw the manager's own open items block, and the refusal names the way out.
env NESS_SESSION=$R
exits 4 ness close $C
stderr $REQ
stderr $DEC
stderr '--withdraw'
exec ness close $C --withdraw --note 'did it myself'
stdout 'withdrew 2 item'
store session $C closed=true
store item $REQ disposition=withdrawn 'answer=did it myself'
store item $DEC disposition=withdrawn 'answer=did it myself'
store items $C 0

-- b.md --
b
