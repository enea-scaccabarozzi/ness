# An adopted root closes like a launched one: its tab is the operator's and stays, the landed
# check guards its worktree, then worktree and integrated branch go; the primary checkout is untouched.
# covers: R-SESS-115
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m 'ness init'
env HERDR_PANE_ID=w1:p7
env HERDR_TAB_ID=w1:t7
env CLAUDE_CODE_SESSION_ID=0bad0bad-0000-4000-8000-000000000001
exec ness open --root --here --scope prog --tier standard --brief ../b.md
store last-session R
exec sh -c 'cd .worktrees/prog-* && echo work > work.txt && printf "## Lessons\nNone.\n" > docs/sessions/prog/report.md && git add -A && git commit -q -m work && ness integrate --subject "feat: x"'
env CLAUDE_CODE_SESSION_ID=
exec sh -c 'cd .worktrees/prog-* && echo late > late.txt && git add -A && git commit -q -m late'
exits 4 ness close $R
stderr 'not integrated into main'
exec sh -c 'cd .worktrees/prog-* && NESS_SESSION=$R ness integrate --subject "feat: x"'
exec ness close $R --note n
store session $R closed=true
exec git worktree list
! stdout worktrees
exec git branch --list 'session/*'
! stdout .
exec git symbolic-ref --short HEAD
stdout '^main$'
exec git show main:work.txt
stdout work

-- b.md --
b
