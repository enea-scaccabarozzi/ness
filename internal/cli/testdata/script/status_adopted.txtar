# A root adopted with --here keeps its transcript where the conversation started, the primary
# checkout, not under its worktree: status shows its context and stats counts it.
# covers: R-SESS-080, R-SESS-114
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m init
env NESS_TEST_NOW=2026-10-09T12:00:00Z
store add-launch s-aaaaaaaaaaaa root - tier=standard client=claude client_session=aaaaaaaa-0000-4000-8000-000000000001 worktree=.worktrees/root-aaaaaaaaaaaa adopted=true
store phase s-aaaaaaaaaaaa ready
exec sh -c 'd=$(pwd -P | sed "s/[^A-Za-z0-9]/-/g"); mkdir -p $HOME/.claude/projects/$d; cp ../a.jsonl $HOME/.claude/projects/$d/aaaaaaaa-0000-4000-8000-000000000001.jsonl'
exec ness status
stdout '^s-aaaaaaaaaaaa\troot\tstandard full\tready\tctx 120k\t'
exec ness stats
stdout '^s-aaaaaaaaaaaa\t1\t1\t'
! stdout 'not counted'
-- a.jsonl --
{"type":"assistant","timestamp":"2026-10-09T11:00:00Z","message":{"id":"m1","model":"claude-sonnet-5-5","usage":{"input_tokens":1000,"output_tokens":100,"cache_read_input_tokens":119000,"cache_creation_input_tokens":0}}}
