# The binary exposes exactly the 21 commands; an unknown command and every flag or command the
# old harness had and ness dropped exit 2 with "unknown".
# covers: R-CFG-030, R-CFG-031
exec ness --help
stdout '^Available Commands:$'
exec sh -c 'ness --help | sed -n "/^Available Commands:/,/^$/p" | grep -E "^  [a-z-]+ " | awk "{print \$1}" | sort | tr "\n" " "'
stdout '^close contract doctor hook inbox init integrate open pick post probe reply secret self-update send size stats status sync upgrade worker $'
exits 2 ness wait
stderr 'unknown command "wait"'
exits 2 ness ship
stderr 'unknown command'
exits 2 ness verify-release
stderr 'unknown command'
exits 2 ness watch
stderr 'unknown command'
exits 2 ness coordination-authorize
stderr 'unknown command'
exits 2 ness status --reconcile
stderr 'unknown flag: --reconcile'
exits 2 ness open --phase x
stderr 'unknown flag: --phase'
exits 2 ness probe verdict x --evidence y
stderr 'unknown flag: --evidence'
exits 2 ness open --pane x
stderr 'unknown flag: --pane'
exits 2 ness open --workspace x
stderr 'unknown flag: --workspace'
exits 2 ness send --request-key x
stderr 'unknown flag: --request-key'
exits 2 ness send --hold
stderr 'unknown flag: --hold'
exits 2 ness send --review-at x
stderr 'unknown flag: --review-at'
exits 2 ness send --transfer-to x
stderr 'unknown flag: --transfer-to'
exits 2 ness send --via x
stderr 'unknown flag: --via'
exits 2 ness reply x --record-operator-response
stderr 'unknown flag: --record-operator-response'
exits 2 ness close x --reap
stderr 'unknown flag: --reap'
exits 2 ness close x --retain-work
stderr 'unknown flag: --retain-work'
exits 2 ness open --model x
stderr 'unknown flag: --model'
