# ness inbox --show A B C prints each body under a header line and marks every one shown; a bad id
# in the list shows nothing; --unread prints every open item not shown yet in full, and nothing
# once all are shown; positional items without --show are a usage error.
# covers: R-MSG-033, R-MSG-037
cd repo
exec ness init --gate true --base main --yes
store add-session s-aaaaaaaaaaaa root
store add-session s-bbbbbbbbbbbb child-b s-aaaaaaaaaaaa
env NESS_TEST_NOW=2026-10-08T10:00:00Z
env NESS_SESSION=s-bbbbbbbbbbbb
exec ness send --to manager --body @../one.txt
store last s-aaaaaaaaaaaa ONE
exec ness send --to manager --body @../two.txt --intent fyi
store last s-aaaaaaaaaaaa TWO
exec ness send --to manager --body 'no newline' --intent decision
store last s-aaaaaaaaaaaa THREE
env NESS_SESSION=s-aaaaaaaaaaaa
env NESS_TEST_NOW=2026-10-08T13:10:00Z
# One bad id among good ones: refused, nothing printed, nothing shown.
exits 4 ness inbox --show $ONE m-nope
! stdout .
store item $ONE shown=false
# Several items: each under its header, in the order asked, bodies exact, all shown.
exec ness inbox --show $TWO $ONE
stdout -count=2 '^--- m-[a-z2-7]{8}\ts-bbbbbbbbbbbb\t'
stdout '^--- m-[a-z2-7]{8}\ts-bbbbbbbbbbbb\tfyi\t3h$'
stdout '^--- m-[a-z2-7]{8}\ts-bbbbbbbbbbbb\trequest\t3h$'
stdout '^second body$'
stdout '^first body$'
stdout '^	indented$'
store item $ONE shown=2026-10-08T13:10:00Z
store item $TWO shown=2026-10-08T13:10:00Z
# --unread prints only the item not shown yet, with a newline after a body that lacks one.
exec ness inbox --unread
stdout -count=1 '^--- '
stdout '^--- m-[a-z2-7]{8}\ts-bbbbbbbbbbbb\tdecision\t3h$'
stdout '^no newline$'
! stdout 'first body'
store item $THREE shown=2026-10-08T13:10:00Z
exec ness inbox --unread
! stdout .
# Items without --show, and --unread with --show, are usage errors.
exits 2 ness inbox $ONE
stderr 'after --show'
exits 2 ness inbox --unread --show $ONE

-- one.txt --
first body
	indented
-- two.txt --
second body
