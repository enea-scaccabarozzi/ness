# A store written by a newer ness is refused with exit 4 and the fix (R-MSG-046, R-CFG-036):
# send and inbox write nothing, and inside the session the hook blocks with the fix (R-UPD-020).
# covers: R-MSG-046
cd repo
exec ness init --gate true --base main --yes
store add-session s-aaaaaaaaaaaa root
store set-version 99
env NESS_SESSION=s-aaaaaaaaaaaa
exits 4 ness send --to operator --body hi
stderr 'upgrade ness'
! stdout .
exits 4 ness inbox
stderr 'upgrade ness'
! stdout .
exits 2 ness hook pre-tool
! stdout .
stderr 'store schema 99.*; fix: ness self-update'
# Back at this binary's version, the refused send left no item.
store set-version current
store items operator 0
