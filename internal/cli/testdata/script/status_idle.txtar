# ness status measures idle from the last real work entry of the transcript, not from the file's
# mtime, which the client's bookkeeping refreshes.
# covers: R-SESS-080
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m 'ness init'
env NESS_TEST_NOW=2026-10-08T10:00:00Z
exec ness open --root --scope prog --tier standard --brief ../b.md
exec sh -c 'ness status --json | grep -o "\"client_session\": *\"[0-9a-f-]*\"" | head -1 | grep -o "[0-9a-f-]\{36\}" > ../cs'
exec sh -c 'd=$(cd .worktrees/prog-* && pwd | sed "s#[^A-Za-z0-9]#-#g"); mkdir -p $HOME/.claude/projects/$d; printf "%s\n" "{\"type\":\"assistant\",\"timestamp\":\"2026-10-08T08:20:00Z\",\"message\":{\"usage\":{\"input_tokens\":1000,\"cache_read_input_tokens\":119000,\"cache_creation_input_tokens\":0}}}" "{\"type\":\"system\",\"subtype\":\"turn_duration\",\"timestamp\":\"2026-10-08T09:59:00Z\"}" > $HOME/.claude/projects/$d/$(cat ../cs).jsonl; touch -d 2026-10-08T09:59:00Z $HOME/.claude/projects/$d/$(cat ../cs).jsonl'
exec ness status
stdout 'idle 100m'
exec ness status --json
stdout '"idle_minutes": 100'

-- b.md --
b
