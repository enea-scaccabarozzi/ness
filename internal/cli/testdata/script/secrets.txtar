# Channel credentials are references: token = "env:NAME" or "secret:NAME" (a literal token and
# token_env are refused); plain keys may be literals or references; an invalid reference name is
# refused. ness secret set/list/unset keep values in the 0600 per-project file and never print
# them; an empty value refuses; a 0644 file is refused with chmod 600. A missing reference
# refuses before any request, a dry run does not need it, post works with an empty environment,
# doctor reports the secrets check, and referenced values are masked in failed-post errors.
# covers: R-CFG-080, R-CFG-081, R-CFG-082, R-CFG-083, R-CFG-084, R-CFG-085, R-NTF-060, R-NTF-061, R-NTF-042
cd repo
exec ness init --gate true --base main --yes
exec git add -A
exec git commit -q -m 'ness init'
exec cp .ness/ness.toml ../base.toml

# A secret: reference, set later. Missing: exit 4, no request, names the secret and no value.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../tg.toml >> .ness/ness.toml'
exits 4 ness post --channel tg --file ../note.md
stderr 'channel tg: token: secret tg is not set in'
! stderr '123:abc'
fake http requests 0
# A dry run does not need the secret.
exec ness post --channel tg --file ../note.md --dry-run
fake http requests 0
# Doctor fails with the fix, naming key and reference.
exits 1 ness doctor
stdout '^fail\tsecrets\t.*secret:tg.*fix: ness secret set tg'
# Nothing was created by the failed attempts.
! exists $XDG_CONFIG_HOME/ness/secrets/repo.toml

# set reads stdin and drops one trailing newline; list shows the name, never the value.
stdin ../tgval
exec ness secret set tg
! stdout .
! stderr '123:abc'
exists $XDG_CONFIG_HOME/ness/secrets/repo.toml
exec sh -c 'test "$(stat -c %a $XDG_CONFIG_HOME/ness/secrets/repo.toml)" = 600'
stdin ../otherval
exec ness secret set other
exec ness secret list
stdout '^tg\treferenced$'
stdout '^other$'
! stdout 'other.*referenced'
! stdout '123:abc'
! stdout 'otherv'
# The file holds the value without the newline.
exec grep -c '^tg = "123:abc"$' $XDG_CONFIG_HOME/ness/secrets/repo.toml
# Doctor is ok and prints no value.
exits 1 ness doctor
stdout '^ok\tsecrets\t'
! stdout '123:abc'
# post with an empty environment sends.
env TG_TOKEN=
exec ness post --channel tg --file ../note.md
fake http requests 1

# A plain key as a secret: reference works, and missing refuses.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../chat.toml >> .ness/ness.toml'
exits 4 ness post --channel tgchat --file ../note.md
stderr 'secret chat is not set'
fake http requests 1
stdin ../chatval
exec ness secret set chat
exec ness post --channel tgchat --file ../note.md
fake http requests 2
# Literal chat_id works (the first config).
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../tg.toml >> .ness/ness.toml'
exec ness post --channel tg --file ../note.md
fake http requests 3

# env: reference: unset refuses before any request; set sends.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../envtok.toml >> .ness/ness.toml'
exits 4 ness post --channel tgenv --file ../note.md
stderr 'channel tgenv: token: TG_TOKEN is not set'
fake http requests 3
env TG_TOKEN=9:envtok
exec ness post --channel tgenv --file ../note.md
fake http requests 4
env TG_TOKEN=

# Config refusals, all exit 4.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../literal.toml >> .ness/ness.toml'
exits 4 ness post --channel tg --file ../note.md --dry-run
stderr 'secret:'
! stderr 'xoxb-1'
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../tokenenv.toml >> .ness/ness.toml'
exits 4 ness post --channel tg --file ../note.md --dry-run
stderr 'token = "env:TG_TOKEN"'
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../badname.toml >> .ness/ness.toml'
exits 4 ness post --channel tg --file ../note.md --dry-run
fake http requests 4

# A secrets file readable by others is refused, naming chmod 600.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../tg.toml >> .ness/ness.toml'
chmod 644 $XDG_CONFIG_HOME/ness/secrets/repo.toml
exits 4 ness post --channel tg --file ../note.md
stderr 'chmod 600'
! stderr '123:abc'
fake http requests 4
exits 1 ness doctor
stdout '^fail\tsecrets\t.*chmod 600'
chmod 600 $XDG_CONFIG_HOME/ness/secrets/repo.toml
exec ness post --channel tg --file ../note.md
fake http requests 5

# An empty value refuses and changes nothing.
stdin ../empty
! exec ness secret set empty
exec ness secret list
! stdout '^empty'

# unset removes the secret; the reference is missing again.
exec ness secret unset tg
exec ness secret list
! stdout '^tg'
stdout '^other$'
exits 4 ness post --channel tg --file ../note.md
stderr 'secret tg is not set'
fake http requests 5

# Masking: a value from env: or secret: never shows in a failed post's error.
exec sh -c 'cp ../base.toml .ness/ness.toml; cat ../leak.toml >> .ness/ness.toml'
env LEAK=leak-env-value
! exec ness post --channel leakenv --file ../note.md
stderr 'token \*\*\*'
! stderr 'leak-env-value'
env LEAK=
stdin ../leakval
exec ness secret set leak
! exec ness post --channel leaksecret --file ../note.md
stderr 'token \*\*\*'
! stderr 'leak-secret-value'

# Outside a project the secret commands refuse.
cd $WORK
exits 4 ness secret list

-- tg.toml --
features = ["notify"]
[notify.channels.tg]
kind = "telegram"
token = "secret:tg"
chat_id = "1001"
-- chat.toml --
features = ["notify"]
[notify.channels.tgchat]
kind = "telegram"
token = "secret:tg"
chat_id = "secret:chat"
-- envtok.toml --
features = ["notify"]
[notify.channels.tgenv]
kind = "telegram"
token = "env:TG_TOKEN"
chat_id = "1001"
-- literal.toml --
features = ["notify"]
[notify.channels.tg]
kind = "slack"
token = "xoxb-1"
channel_id = "C0TEST"
-- tokenenv.toml --
features = ["notify"]
[notify.channels.tg]
kind = "telegram"
token_env = "TG_TOKEN"
chat_id = "1001"
-- badname.toml --
features = ["notify"]
[notify.channels.tg]
kind = "telegram"
token = "secret:tg"
chat_id = "secret:bad name"
-- leak.toml --
features = ["notify"]
[notify.channels.leakenv]
kind = "command"
token = "env:LEAK"
command = "echo token leak-env-value; exit 1"
[notify.channels.leaksecret]
kind = "command"
token = "secret:leak"
command = "echo token leak-secret-value; exit 1"
-- note.md --
Hello **world**.
-- tgval --
123:abc
-- otherval --
otherv
-- chatval --
1001
-- leakval --
leak-secret-value
-- empty --
