echo ness version 0.1.0
-- empty --
-- startup.json --
{"hook_event_name":"SessionStart","source":"startup","session_id":"c0ffee"}
-- notify.toml --

[update]
auto = "notify"
-- off.toml --

[update]
auto = "off"
-- install.toml --

[update]
auto = "install"
-- conf.toml --
ness = "0.1"
project = "conf"
base = "main"
gate = "true"
profiles = ["local"]

[update]
auto = "install"
-- conf/.ness/profiles/local/profile.toml --
name = "local"
[files]
"docs/x.md" = { own = "x.md" }
-- one.md --
one
-- two.md --
two
-- mine.md --
