# ness stats --by rung groups cost by rung: the session's own turns at its tier, each subagent's at
# the rung its meta model/effort finds on the ladder; a meta with neither (Claude Code's real
# shape for a named agent or a fork) at the named agent's rendered rung, else the session's tier;
# off-ladder otherwise; --by role adds a subagent row; no turn or tool byte is counted twice
# (the total stays 950 cents and 60 tool bytes).
# covers: R-STAT-020, R-STAT-021
cd repo
exec ness init --gate true --base main --yes
store add-launch s-aaaaaaaaaaaa root - tier=standard client=claude client_session=aaaaaaaa-0000-4000-8000-000000000001
exec sh -c 'd=$HOME/.claude/projects/$(pwd -P | sed "s/[^A-Za-z0-9]/-/g"); s=$d/aaaaaaaa-0000-4000-8000-000000000001; mkdir -p $s/subagents; cp ../s1.jsonl $s.jsonl; cp ../agent-* $s/subagents/'

# Rejects: subagent cost folded into the session's rung, a subagent grouped by its agent type,
# a model not on the ladder dropped or forced onto a rung, a total that counts subagents twice,
# a defaults-only named agent (d4, ness-sweep) put off-ladder instead of economy, and a fork (e5)
# put off-ladder instead of the session's tier standard.
exec ness stats --by rung --json
stdout '"by": "rung"'
stdout -count=1 '"key": "standard"'
stdout -count=1 '"key": "economy"'
stdout -count=1 '"key": "deep"'
stdout -count=1 '"key": "off-ladder"'
stdout -count=4 '"key": "(standard|economy|deep|off-ladder)"'
stdout '(?s)"key": "standard".*?"cost_cents": 500,'
stdout '(?s)"key": "economy".*?"cost_cents": 300,'
stdout '(?s)"key": "deep".*?"cost_cents": 100,'
stdout '(?s)"key": "off-ladder".*?"cost_cents": 50,'
stdout '(?s)"key": "total".*?"cost_cents": 950,'
# Rejects: subagent tool bytes added into the session's own row as well (rows must sum to 60).
stdout '(?s)"key": "standard".*?"tool_bytes": 10,'
stdout '(?s)"key": "economy".*?"tool_bytes": 50,'
stdout '(?s)"key": "total".*?"tool_bytes": 60,'

# Rejects: subagent turns or tool bytes charged to the root's role.
exec ness stats --by role --json
stdout '(?s)"key": "root".*?"cost_cents": 400,.*?"tool_bytes": 10,'
stdout '(?s)"key": "subagent".*?"cost_cents": 550,.*?"tool_bytes": 50,'
stdout '(?s)"key": "total".*?"cost_cents": 950,.*?"tool_bytes": 60,'

# Rejects: a session total that changes with the grouping (subagents dropped by --by session).
exec ness stats --json
stdout '(?s)"key": "total".*?"cost_cents": 950,'

-- s1.jsonl --
{"type":"user","timestamp":"2026-10-09T10:00:00.000Z","message":{"role":"user","content":"do it"}}
{"type":"assistant","timestamp":"2026-10-09T10:00:04.000Z","message":{"model":"claude-opus-5-5","usage":{"input_tokens":1000000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"content":[{"type":"text","text":"ok"}],"id":"msg_1"}}
{"type":"user","timestamp":"2026-10-09T10:00:05.000Z","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"t1","content":"0123456789"}]}}
