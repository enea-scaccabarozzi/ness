{"isSidechain":true,"agentId":"a1","type":"assistant","timestamp":"2026-10-09T10:01:04.000Z","message":{"model":"claude-sonnet-5-5","usage":{"input_tokens":1000000,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"content":[{"type":"text","text":"found"}],"id":"msg_s1"}}
