# A broken or invalid ness.toml is refused (exit 4), naming the position or key, and nothing is written.
# covers: R-CFG-003, R-CFG-004, R-CFG-040, R-CFG-043, R-UPD-030
cd repo
snap before
exits 4 ness sync --check
stderr '\.ness/ness\.toml:5:\d+:'
samesnap before

cp ../bad-enum.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'client = "gpt": accepted values are claude, codex'

cp ../unknown.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'unknown key worker\.stal_minutes'

cp ../no-gate.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'gate is required'

# rejects: accepting any string for update.channel, update.auto or update.check
cp ../bad-channel.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'update.channel = "beta": accepted values are stable, rc'

cp ../bad-auto.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'update.auto = "always": accepted values are off, notify, install'

cp ../bad-check.toml .ness/ness.toml
exits 4 ness sync --check
stderr 'update\.check'

-- repo/.ness/ness.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
x = ]
-- bad-enum.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
client = "gpt"
-- unknown.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
[worker]
stal_minutes = 5
-- no-gate.toml --
ness = "0.1"
project = "p"
base = "main"
-- bad-channel.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
[update]
channel = "beta"
-- bad-auto.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
[update]
auto = "always"
-- bad-check.toml --
ness = "0.1"
project = "p"
base = "main"
gate = "make validate"
[update]
check = "yes"
